# Copy to .env and add the keys you have. Never commit .env.
# Everything is optional: keyless sources work without any keys.

# The tool listens on this computer only. Don't expose it to the internet.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# Only needed behind a reverse proxy: addresses/subnets to trust for client IPs (empty = none)
TRUST_PROXY=
RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS_PER_IP=10
# Sent to upstream APIs; adding your e-mail or repo URL is good practice.
UPSTREAM_USER_AGENT=gbg-osint-dashboard/0.1

# --- API keys (server-only; a source stays "Needs key" until its key is set) ---
# Västtrafik developer portal (Planera Resa v4, OAuth2 client credentials)
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=
# Trafiklab – GTFS Regional static
TRAFIKLAB_GTFS_REGIONAL_KEY=
# Trafikverket Open API
TRAFIKVERKET_API_KEY=
# Göteborgs Stad open data (psidata AppId)
GBG_STAD_APP_ID=
# aisstream.io
AISSTREAM_API_KEY=
# Swedavia API portal – Flight Info subscription key
SWEDAVIA_FLIGHTINFO_KEY=
# CARTO API key for base maps
CARTO_API_KEY=
# Cesium ion access token (free Community plan, non-commercial): 3D terrain and buildings.
# Sent to the browser like the CARTO key; scope it to assets:read only.
CESIUM_ION_ACCESS_TOKEN=